{
  "appId": "com.sistemagestionpro.app",
  "productName": "Sistema Gestión PRO",
  "electronVersion": "22.3.27",
  "asar": false,
  "directories": {
    "buildResources": "build"
  },
  "files": [
    "backend/**/*",
    "public/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["ia32"]
      }
    ],
    "icon": "build/logo-sistemaGestion.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "artifactName": "${productName} Setup ${version} (Win7-32bit).${ext}"
  },
  "publish": null
}
